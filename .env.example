# ============================================
# Hockey Analytics Dashboard - Configuration
# ============================================
# Copy this file to .env and configure for your environment
# cp .env.example .env

# ============================================
# REQUIRED SETTINGS
# ============================================

# API Security (REQUIRED)
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=your-api-key-change-this-in-production
API_SECRET_KEY=your-secret-key-change-this-in-production

# CORS Configuration (REQUIRED for production)
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ============================================
# SERVER SETTINGS
# ============================================

# Server binding
HOST=0.0.0.0
PORT=8000

# Number of gunicorn workers (default: auto-calculated)
# WORKERS=4

# Debug mode (MUST be false in production)
DEBUG_MODE=false

# ============================================
# RATE LIMITING
# ============================================

# Requests allowed per window
RATE_LIMIT_REQUESTS=100

# Window size in seconds
RATE_LIMIT_WINDOW=60

# ============================================
# LOGGING
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================
# ERROR MONITORING (Optional)
# ============================================

# Sentry DSN for error tracking
# Get your DSN from https://sentry.io
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Sentry traces sample rate (0.0 to 1.0)
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Environment name for Sentry
ENVIRONMENT=production

# Application version
APP_VERSION=2.0.0

# ============================================
# DATABASE (Future use)
# ============================================

# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=your_username
# DATABASE_PASSWORD=your_secure_password
# DATABASE_NAME=hockey_analytics

# ============================================
# NHL API (Optional)
# ============================================

# NHL API base URL
NHL_API_BASE_URL=https://api-web.nhle.com/v1

# Rate limit for NHL API calls (requests per second)
NHL_API_RATE_LIMIT=0.5
